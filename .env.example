# --- Obligatoire ---------------------------------------------------------
# Token donné par @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-remplace-moi
# Ton chat id (le bot te le donne après /start). Laisser vide = le premier /start devient propriétaire.
TELEGRAM_CHAT_ID=

# --- Optionnel : explications intelligentes des mouvements (Claude) ------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high  (plus haut = plus poussé mais plus lent/cher)
CLAUDE_EFFORT=medium
# 1 = Claude cherche les dernières nouvelles sur le web pour trouver la vraie cause
CLAUDE_WEB_SEARCH=1

# --- Réglages ------------------------------------------------------------
TZ_NAME=America/Toronto
# Tickers Yahoo Finance (NQ=F = futures Nasdaq 100, GC=F = futures or ≈ XAUUSD)
NQ_TICKER=NQ=F
XAU_TICKER=GC=F
# Seuils d'alerte "gros mouvement" en %
NQ_MOVE_15M_PCT=0.6
NQ_MOVE_60M_PCT=1.1
XAU_MOVE_15M_PCT=0.45
XAU_MOVE_60M_PCT=0.9
# Qualité minimale d'un signal automatique (0-100) et délai entre 2 signaux dans le même sens
MIN_SIGNAL_SCORE=70
SIGNAL_COOLDOWN_HOURS=4
MIN_NEWS_SCORE=6
# News envoyées automatiquement : importance minimale (1 à 5, 4 = fort impact seulement) et max par heure
NEWS_MIN_IMPORTANCE=4
NEWS_MAX_PER_HOUR=3
# Mode des news automatiques :
#   ia        = Claude lit tout et t'écrit SEULEMENT quand c'est vraiment important (défaut, le plus calme)
#   mouvement = compte rendu d'une news seulement si le Nasdaq ou l'or bouge après sa sortie
#   impact    = chaque news à fort impact (bavard)    aucune = rien d'automatique
NEWS_MODE=ia
NEWS_MAX_PER_DAY=4
# Mode « mouvement » : mouvement minimal après la news (%) et durée de surveillance
NQ_NEWS_MOVE_PCT=0.35
XAU_NEWS_MOVE_PCT=0.3
NEWS_WATCH_MINUTES=90
# Heures de silence (seuls les gros mouvements passent)
QUIET_HOURS=22:00-07:00
# Alerte quand le prix approche d'un niveau clé : 1 = oui ; distance en % du prix ; max par heure
LEVEL_ALERTS=0
LEVEL_ALERT_PCT=0.1
LEVEL_ALERTS_PER_HOUR=4
# Heures du résumé des news (jours de semaine)
# (vide = pas de résumé automatique, disponible avec /resume)
DIGEST_TIMES=
CALENDAR_REMINDER_MINUTES=30
MORNING_BRIEF_TIME=08:45
STOCKS_REPORT_TIME=17:15
# 1 = rapport actions seulement le dimanche, 0 = chaque soir de semaine
STOCKS_REPORT_WEEKLY=1
# 1 = message quand le type de marché H4 change
REGIME_ALERTS=0
# Actions : baisse minimale depuis le sommet 52 semaines, fenêtre earnings (jours)
DIP_THRESHOLD_PCT=20
EARNINGS_LOOKAHEAD_DAYS=14
# Watchlist (sinon liste par défaut US + Canada). Modifiable aussi avec /ajouter et /retirer
# STOCK_WATCHLIST=AAPL,MSFT,NVDA,RY.TO

# --- Optionnel : sentiment des traders particuliers (compte GRATUIT sur myfxbook.com) ---------
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=
