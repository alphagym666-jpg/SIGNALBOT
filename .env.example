# --- Obligatoire ---------------------------------------------------------
# Token donné par @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-remplace-moi
# Ton chat id (le bot te le donne après /start). Laisser vide = le premier /start devient propriétaire.
TELEGRAM_CHAT_ID=

# --- Optionnel : explications intelligentes des mouvements (Claude) ------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (plus haut = plus poussé mais plus lent/cher)
CLAUDE_EFFORT=medium
# 1 = Claude cherche les dernières nouvelles sur le web pour trouver la vraie cause
CLAUDE_WEB_SEARCH=1

# --- Réglages ------------------------------------------------------------
TZ_NAME=America/Toronto
# Tickers Yahoo Finance (NQ=F = futures Nasdaq 100, GC=F = futures or ≈ XAUUSD)
NQ_TICKER=NQ=F
XAU_TICKER=GC=F
# Seuils d'alerte "gros mouvement" en %
NQ_MOVE_15M_PCT=0.6
NQ_MOVE_60M_PCT=1.1
XAU_MOVE_15M_PCT=0.45
XAU_MOVE_60M_PCT=0.9
# Qualité minimale d'un signal automatique (0-100) et délai entre 2 signaux dans le même sens
MIN_SIGNAL_SCORE=70
SIGNAL_COOLDOWN_HOURS=4
MIN_NEWS_SCORE=6
CALENDAR_REMINDER_MINUTES=30
MORNING_BRIEF_TIME=08:45
STOCKS_REPORT_TIME=17:15
# Actions : baisse minimale depuis le sommet 52 semaines, fenêtre earnings (jours)
DIP_THRESHOLD_PCT=20
EARNINGS_LOOKAHEAD_DAYS=14
# Watchlist (sinon liste par défaut US + Canada). Modifiable aussi avec /ajouter et /retirer
# STOCK_WATCHLIST=AAPL,MSFT,NVDA,RY.TO
